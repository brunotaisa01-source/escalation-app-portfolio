{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": false,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/domain/**/*.js",
    "src/services/csv-export.js",
    "launcher/**/*.js",
    "launcher/**/*.d.ts"
  ],
  "exclude": ["dist", "node_modules", "../**/node_modules", "../**/.cache"]
}
